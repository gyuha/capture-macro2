{
    "qtForPython.qmlls.enabled": false,
    "code-runner.executorMap": {
        "python": "$pythonPath -u $fullFileName"
    },
    "qtForPython.designer.path": "${workspaceFolder}/venv/Scripts/pyside6-designer.exe",
    "qtForPython.uic.path": "${workspaceFolder}/venv/Scripts/pyside6-uic.exe",
    "qtForPython.qmlformat.path": "${workspaceFolder}/venv/Scripts/pyside6-qmlformat.exe",
    "qtForPython.qmlls.path": "${workspaceFolder}/venv/Scripts/pyside6-qmlls.exe",
    
    // Python 린터 설정
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.flake8Enabled": false,
    "python.linting.mypyEnabled": false,
    
    // Python 포맷터 설정
    "python.formatting.provider": "none",
    "editor.formatOnSave": false,
    
    // 특정 파일에 대한 포맷 규칙 무시
    "[python]": {
        "editor.formatOnSave": false
    },
    
    // 특정 파일 타입에 대한 파일 관련 설정
    "files.associations": {
        "app/config/version.py": "plaintext"
    }
}